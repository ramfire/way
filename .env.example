# Modèle de /opt/alfaway/.env (copier, renseigner, chmod 640 ubuntu:www-data).
# Ne jamais committer le .env réel.
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=alfaway.algotech.lu,localhost,127.0.0.1
DATABASE_URL=

# Scaleway Object Storage
SCW_ACCESS_KEY=
SCW_SECRET_KEY=
SCW_ENDPOINT=
SCW_REGION=fr-par
SCW_BUCKET_PREFIX=

# Tokens internes (webhook SFTPGo, appels internes)
SFTPGO_WEBHOOK_TOKEN=
INTERNAL_TOKEN=

# Acta (référentiel fonds)
ACTA_URL=
ACTA_HOST=
ACTA_USER=
ACTA_PASSWORD=

# Layout visuel de l'admin (core/layouts.py) ; nom inconnu → generali.
ALFAWAY_LAYOUT=generali
